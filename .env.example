# これを .env.local にコピーして値を埋める（.env.local は .gitignore 済み）

# ── TMDB ──────────────────────────────────────────────
# VITE_ を付けないこと。付けるとバンドルに焼き込まれ、
# 公開URLからトークンが誰でも読めてしまう。
# cinema-roadmap/.env.local の VITE_TMDB_TOKEN と同じ値でよい。
TMDB_TOKEN=eyJhbGciOi...

# ── Firebase ──────────────────────────────────────────
# 未設定のままでもアプリは動く（データはブラウザのlocalStorageに保存される）。
# スマホと同期したくなったらFirebaseのプロジェクトを作って埋める。
# https://console.firebase.google.com → プロジェクトを追加 → ウェブアプリを追加
# すると出てくる設定オブジェクトの値をそのまま入れる。
#
# TMDBのトークンと違い、この値はVITE_を付けて公開して問題ない
# （実際のアクセス制御はfirebase/firestore.rulesと許可済みドメインで行う）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
